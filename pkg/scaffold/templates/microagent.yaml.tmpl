name: {{.Name}}
image: docker.io/library/python:3.13-slim
setup:
  - pip install --no-cache-dir 'pydantic>=2.0,<3' '{{.SDKSpec}}'
  - mkdir -p /app /agent /workspace
entrypoint: python /app/body.py
files:
  - src: ./body.py
    dst: /app/body.py
  - src: ./protocol.py
    dst: /app/protocol.py
  - src: ./demo/constraints.json
    dst: /agent/constraints.json
  - src: ./demo/system_prompt.md
    dst: /agent/system_prompt.md
outputs:
  - name: result
    path: /workspace/result.json
# Mediation: the guest-to-host vsock channel an enforcer/orchestrator uses to
# govern this body. The body already speaks the protocol side — it loads the
# constraint envelope and emits lifecycle signals (ready, accepting, completed,
# mediation_broken). Uncomment and point `target` at your enforcer to require
# the channel; `failClosed` treats a broken required channel as denied.
# mediation:
#   enabled: true
#   required: true
#   port: 2048
#   target: 127.0.0.1:9900
#   failClosed: true
